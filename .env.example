# collab-docs environment.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_SECRET=|AUTH_SECRET=$(openssl rand -base64 32)|" .env
#
# Every name here is declared in turbo.json. That is not a convention, it is a
# gate: `node scripts/env-contract.mjs` fails the commit if this file, the source
# and turbo.json disagree in any of four directions. Turborepo 2 runs in strict
# environment mode, so a name turbo.json forgets is stripped from the child
# process silently and the app boots misconfigured rather than loudly broken.
#
# Nothing loads this file on its own. `pnpm dev` runs scripts/dev.sh, which
# sources it, checks AUTH_SECRET and preflights the datastores before handing off
# to turbo.

# --- Core ---

# Next.js and Nest read this themselves. Leave it unset for local development;
# `next build` must not see "development" or it pulls the dev React runtime and
# prerendering breaks.
NODE_ENV=

# Reported by /health so a running process can be identified.
APP_VERSION=0.1.0

# --- Database (Postgres) ---

# Ports are deliberately off the defaults. The dev host runs a system PostgreSQL
# on 5432 and the six sibling portfolio stacks own 5433-5438 and 6380-6385
# (5439 is held by an unrelated stack on the build machine), so this project
# takes 5440/6386 and every URL below matches.
DATABASE_URL=postgresql://collab:collab@localhost:5440/collab?schema=public

# Prisma migrations cannot run through a transaction-mode pooler. Locally this is
# the same server; the two names exist so the split is possible without a code
# change.
DIRECT_DATABASE_URL=postgresql://collab:collab@localhost:5440/collab?schema=public

# --- Redis ---

# Not a cache here. It carries the Hocuspocus Redis extension's pub/sub, which is
# the only path a document update takes from one sync replica to another. Without
# it two browsers on the same document keep typing and never converge.
REDIS_URL=redis://localhost:6386

# --- API service (REST) ---

# Documents, folders, roles, share links, versions and search. It never touches
# the CRDT stream.
API_PORT=4000

# Where the web app's server components reach the API. Server-side only, so it
# stays a container name in Docker.
API_BASE_URL=http://localhost:4000

# --- Sync service (Yjs over WebSocket) ---

# The Hocuspocus server. One port serves both the websocket upgrade and /health,
# so the Docker healthcheck probes the same process the sockets are on.
SYNC_PORT=4100

# PORT wins over SYNC_PORT in apps/sync/src/config.ts. That precedence is what
# lets infra/docker-compose.yml's `sync-2` service reuse the first replica's image
# and answer on 4101 with no second Dockerfile. Leave it empty locally: setting it
# here would also move the API, which reads PORT with the same precedence.
PORT=

# Server-side base URL for the sync server, used by /health aggregation.
SYNC_BASE_URL=http://localhost:4100

# The second replica, when one is running. Empty for `pnpm dev`, which starts one:
# the web app's /status probes this URL when it is set, and a value pointing at a
# replica that does not exist reports an outage that is not one. The integration
# lane and the compose `app` profile start a second replica and set
# http://localhost:4101 themselves; if it equals SYNC_BASE_URL the cross-replica
# test says so and fails rather than passing against one server.
SYNC_BASE_URL_2=

# Baked into the browser bundle at build time, so it must be reachable from the
# reader's machine and not from inside the Docker network.
NEXT_PUBLIC_SYNC_URL=ws://localhost:4100

# --- Web app ---

WEB_PORT=3000
APP_BASE_URL=http://localhost:3000

# There is deliberately no NEXT_PUBLIC_API_BASE_URL. The browser never calls the
# API: server components read through it and server actions write through it,
# each with a fresh service token, so the API has no CORS surface and no REST
# token ever reaches browser JavaScript (docs: SPECS 12.3). The socket is the one
# connection the browser opens itself, which is why NEXT_PUBLIC_SYNC_URL exists.

# --- Auth ---

# One value, three processes: the web app mints a short-lived HS256 service token
# with it, the API and the sync server verify it. At least 16 characters;
# scripts/dev.sh refuses to start without one.
AUTH_SECRET=

# Auth.js reads this directly to build callback URLs.
AUTH_URL=http://localhost:3000

# --- Persistence: checkpoint, log and compaction ---

# A CRDT lives in memory, and the obvious persistence design writes it on a timer,
# which loses every keystroke since the last write when the process dies. Instead
# every update is appended synchronously to document_updates, and the checkpoint
# in documents.state is a compaction of that log rather than the only copy.

# Compact when the log for a document passes this many rows. Small enough that a
# reload never replays a noticeable amount, large enough that an ordinary typing
# session is not one transaction per keystroke.
COMPACT_AFTER_UPDATES=200

# ...or when the oldest un-compacted update for a document is this old, so a
# document edited slowly still gets a checkpoint.
COMPACT_AFTER_SECONDS=120

# Hocuspocus debounces its own store hook. These bound how long compaction can be
# deferred while somebody is typing continuously. They are a performance knob and
# not a durability one: the append-only log is what makes a crash survivable, and
# it is not debounced at all.
STORE_DEBOUNCE_MS=2000
STORE_MAX_DEBOUNCE_MS=10000

# --- Version history ---

# An automatic version is cut at most this often, and only if the document
# actually changed since the last one.
VERSION_INTERVAL_SECONDS=300

# Versions are full document states. Beyond this count the oldest automatic
# versions are pruned; a version somebody labelled by hand is never pruned.
VERSION_MAX_PER_DOCUMENT=50

# --- Sync limits ---

# Largest single websocket frame accepted. A Yjs update is normally tiny; a large
# paste is the case that makes this non-trivial.
SYNC_MAX_PAYLOAD_BYTES=1048576

# Messages per minute per connection, enforced in-process. A socket lives on
# exactly one replica for its whole life, so there is nothing to share and this
# does not belong in Redis.
SYNC_MESSAGE_RATE_LIMIT=1200

# How long a cursor survives without an awareness update before it is removed.
# A stale caret with somebody's name on it is worse than no caret.
AWARENESS_TIMEOUT_MS=30000

# --- Documents ---

DOCUMENT_LIST_PAGE_SIZE=25

# Refuse an update that would take a document past this size. Without a ceiling a
# single client can grow a document until the server cannot hold it in memory.
DOCUMENT_MAX_BYTES=5242880

# --- Sharing ---

# Default lifetime of a share link when the creator does not choose one.
SHARE_LINK_TTL_HOURS=168

# --- HTTP rate limits ---

# Requests per minute. The auth budget must stay below the global one or
# apps/api/src/config/boot.ts refuses to start, because a larger auth budget is
# always a mistake rather than a choice.
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5
