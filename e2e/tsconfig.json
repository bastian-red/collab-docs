{
  "extends": "@docs/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // `dom` as well as node: `page.evaluate` bodies run in the browser.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
