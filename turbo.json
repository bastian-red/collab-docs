{
  "$schema": "https://turbo.build/schema.json",

  // Turborepo 2 defaults to envMode: "strict". A task's child process sees only
  // the names listed below plus turbo's own system allowlist; everything else is
  // stripped with no warning. That is left on deliberately -- it is the reason
  // scripts/env-contract.mjs can be a meaningful gate -- but it does mean a name
  // this file forgets is a name the running app never sees.
  //
  // Verify with: turbo run dev --dry=json   (it reports globalEnvMode).

  // globalEnv values are hashed into the cache key, so this list is only for
  // names that change what gets BUILT. NEXT_PUBLIC_* qualify because Next.js
  // inlines them into the client bundle at build time: change one and the
  // artefact is genuinely different. A secret must never appear here, because
  // its value would become part of a hash input.
  "globalEnv": ["API_BASE_URL", "NEXT_PUBLIC_SYNC_URL", "NODE_ENV"],

  // Runtime configuration. Read by the process, never baked into an artefact,
  // so a change here must not invalidate a cached build.
  "globalPassThroughEnv": [
    "API_PORT",
    "APP_BASE_URL",
    "APP_VERSION",
    "AUTH_SECRET",
    "AUTH_URL",
    "AWARENESS_TIMEOUT_MS",
    "COMPACT_AFTER_SECONDS",
    "COMPACT_AFTER_UPDATES",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "DOCUMENT_LIST_PAGE_SIZE",
    "DOCUMENT_MAX_BYTES",
    "PORT",
    "RATE_LIMIT_AUTH",
    "RATE_LIMIT_GLOBAL",
    "REDIS_URL",
    "SHARE_LINK_TTL_HOURS",
    "STORE_DEBOUNCE_MS",
    "STORE_MAX_DEBOUNCE_MS",
    "SYNC_BASE_URL",
    "SYNC_BASE_URL_2",
    "SYNC_MAX_PAYLOAD_BYTES",
    "SYNC_MESSAGE_RATE_LIMIT",
    "SYNC_PORT",
    "TZ",
    "VERSION_INTERVAL_SECONDS",
    "VERSION_MAX_PER_DOCUMENT",
    "WEB_PORT"
  ],

  "tasks": {
    // dependsOn ^build because every app imports workspace packages through
    // dist/. On a machine that has built once this looks unnecessary; on a clean
    // checkout it is the difference between a working command and a stack trace
    // about a missing module.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // @docs/db's export-map test loads the package's OWN dist through require()
    // and import, which is the only way to prove the `./documents` subpath really
    // has no require condition. ^build builds its dependencies, not itself, so on
    // a fresh clone that test found no dist/ at all. CI caught it; locally a
    // stale dist hid it.
    "@docs/db#test": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "migrate:deploy": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
